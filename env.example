# korean-rnd-mcp — HTTP(공개) 모드 환경변수 예시
# 실제 값은 서빙 호스트의 .env에만 기입한다. 비밀값을 리포·채팅에 넣지 말 것.

# --- 질의 임베딩 백엔드 ---
# local(기본, Mac 개발용) | workersai(공개 배포 — 호환 검증 PASS 후에만)
RND_FACTLINK_EMBED_BACKEND=local
# Cloudflare Workers AI (backend=workersai일 때 필수)
CF_ACCOUNT_ID=
CF_WORKERS_AI_TOKEN=
# 일일 임베딩 예산(뉴런, 추정치 기준·fail-closed) — 결정 #11
RND_FACTLINK_EMBED_DAILY_NEURONS=25000

# --- HTTP 전송 ---
# 컨테이너 안에서는 0.0.0.0, 호스트 직접 실행은 127.0.0.1(기본)
RND_FACTLINK_HTTP_HOST=127.0.0.1
PORT=8081

# --- 남용 통제 ---
# 이 경로에 파일이 존재하면 전 요청 503 (예: touch로 즉시 중단)
RND_FACTLINK_KILL_SWITCH=
RND_FACTLINK_MAX_BODY=65536
RND_FACTLINK_RATE_CAPACITY=10
RND_FACTLINK_RATE_REFILL=0.5
RND_FACTLINK_MAX_CONCURRENCY=4
